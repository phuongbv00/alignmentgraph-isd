{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADDIEOutput",
  "type": "object",
  "required": ["analysis", "design", "development", "implementation", "evaluation"],
  "additionalProperties": true,
  "properties": {
    "analysis": {
      "type": "object",
      "additionalProperties": true,
      "required": ["needs_analysis", "learner_analysis", "context_analysis", "task_analysis"],
      "properties": {
        "needs_analysis": {"type": "object"},
        "learner_analysis": {"type": "object"},
        "context_analysis": {"type": "object"},
        "task_analysis": {"type": "object"}
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": true,
      "required": ["learning_objectives", "instructional_strategies"],
      "properties": {
        "learning_objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_:\\-]*$"},
              "statement": {"type": "string"},
              "bloom_verb": {"type": "string"}
            }
          }
        },
        "instructional_strategies": {"type": "object"}
      }
    },
    "development": {
      "type": "object",
      "additionalProperties": true,
      "required": ["learner_materials", "assessment_tools"],
      "properties": {
        "learner_materials": {"type": "array"},
        "assessment_tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item_id"],
            "properties": {
              "item_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_:\\-]*$"},
              "aligned_objective": {"type": "string"}
            }
          }
        },
        "expert_review": {"type": "object"}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["instructor_orientation", "system_check", "prototype_execution", "monitoring"],
      "properties": {
        "instructor_orientation": {"type": "object"},
        "system_check": {"type": "object"},
        "prototype_execution": {"type": "object"},
        "monitoring": {"type": "object"}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["formative", "summative", "improvement_plan"],
      "properties": {
        "formative": {"type": "object"},
        "summative": {"type": "object"},
        "improvement_plan": {"type": "object"}
      }
    },
    "trajectory": {"type": "object"},
    "metadata": {"type": "object"}
  }
}

# Model the harness runs on. Shared with the CLI and the benchmark — the demo
# web app deliberately has no model configuration of its own.
AGENT_MODEL_NAME=
AGENT_MODEL_API_SPEC=openai_compatible
AGENT_MODEL_BASE_URL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_TEMPERATURE=0.7
AGENT_MODEL_MAX_TOKENS=8192

# Demo web app (alignmentgraph_isd.server). All optional.
AGISD_SERVER_DATA_ROOT=.agisd-server-data
AGISD_SERVER_MAX_CONCURRENT_RUNS=2
# Serve the built UI from the API process, so the demo is one URL. Build it
# first: cd src/alignmentgraph_isd/webapp && npm run build
AGISD_SERVER_SERVE_SPA=0
